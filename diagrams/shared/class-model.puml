' Shared proposed architecture. Editable by stage via STAGE defined in each file.
!pragma layout smetana
hide circle
hide empty members
skinparam defaultFontSize 13
skinparam nodesep 38
skinparam ranksep 52
skinparam classBackgroundColor<<new>> #EAF4EE
skinparam classBackgroundColor<<changed>> #FFF6DE
skinparam classBorderColor<<new>> #527760
skinparam classBorderColor<<changed>> #A58744

class RestaurantRush <<boundary>> {
  - game : RestaurantGameInterface
  + play() : void
}
!if $STAGE == 3
interface RestaurantGameInterface <<interface>> #FFF6DE {
!else
interface RestaurantGameInterface <<interface>> {
!endif
  + startTurn() : void
  + seat(customerId: int, tableNumber: int) : void
  + order(customerId: int) : void
  + serve(customerId: int) : void
  + prepare(customerId: int) : void
  + finishTurn() : void
  + victory() : boolean
!if $STAGE == 3
  + activateHappyHour() : void
  + beginService() : void
  + waitHost() : void
  + seatWithHost(customerId: int, tableNumber: int) : void
!endif
}
!if $STAGE == 3
class RestaurantGame <<control>> #FFF6DE {
!else
class RestaurantGame <<control>> {
!endif
  - turn : int
  - revenueCents : int
!if $STAGE == 3
  - happyHourUsed : boolean = false
  - happyHourStartTurn : int = -1
!endif
  + startTurn() : void
  + order(customerId: int) : void
  + finishTurn() : void
  - calculateBill(customer: Customer, item: MenuItemInterface) : int
!if $STAGE == 3
  + activateHappyHour() : void
  + beginService() : void
  + waitHost() : void
  + seatWithHost(customerId: int, tableNumber: int) : void
  - isHappyHourActive() : boolean
  - recoverWaitingCustomers() : void
  - seatUsing(role: Seating, customer: Customer, table: Table) : void
!endif
}
abstract class Staff {
  - used : boolean
  + beginTurn() : void
  + available() : boolean
  # requireAvailable() : void
  # recordSuccessfulTask() : void
}
!if $STAGE == 3
class Waiter <<changed>> {
!else
class Waiter {
!endif
  + seat(customer: Customer, table: Table) : void
  + takeOrder(customer: Customer, item: MenuItemInterface, bill: int) : void
  + serve(customer: Customer, turn: int) : void
}
class Chef {
  + prepare(customer: Customer, turn: int) : void
}
class Cashier {
  + collectPayment(customers: List<Customer>, turn: int) : int
}
!if $STAGE == 3
abstract class Customer <<entity>> #FFF6DE {
!else
abstract class Customer <<entity>> {
!endif
  - id : int
  - satisfaction : int = 100
  - state : Customer.State
  - servedTurn : int
  - readyToPayTurn : int
  + selectItem(menu: List<MenuItemInterface>) : MenuItemInterface
  + billAfterDiscount(baseCents: int) : int
  + placeOrder(item: MenuItemInterface, billCents: int) : void
  + waitAtTurnEnd() : void
  + receiveFood(turn: int) : void
  + finishEating(turn: int) : void
  + pay(turn: int) : int
!if $STAGE == 3
  + recoverSatisfaction(points: int) : void
!endif
  {abstract} # satisfactionLoss() : int
  {abstract} # chooseMenuItem(menu: List<MenuItemInterface>) : MenuItemInterface
}
class RegularCustomer {
  # satisfactionLoss() : int
  # chooseMenuItem(menu: List<MenuItemInterface>) : MenuItemInterface
}
class Table <<entity>> {
  - number : int
  + isFree() : boolean
  + seat(customer: Customer) : void
  ~ release(customer: Customer) : void
}
class Order <<entity>> {
  - billCents : int {readOnly}
  - unitsPrepared : int
  - readyTurn : int
  - status : Order.Status
  + Order(item: MenuItemInterface, billCents: int)
  + prepareOneUnit(turn: int) : void
  + serve(turn: int) : void
  + markPaid() : void
  + billCents() : int
}
interface MenuItemInterface <<interface>> {
  + displayName() : String
  + priceCents() : int
  + preparationUnits() : int
}
class MenuItem {
  - displayName : String {readOnly}
  - priceCents : int {readOnly}
  - preparationUnits : int {readOnly}
  + MenuItem(name: String, priceCents: int, units: int)
}

RestaurantRush -down-> "1" RestaurantGameInterface : -game
RestaurantGameInterface <|.. RestaurantGame
RestaurantGame "1" *-down- "1" Waiter : -waiter
RestaurantGame "1" *-down- "1" Chef : -chef
RestaurantGame "1" *-down- "1" Cashier : -cashier
Staff <|-down- Waiter
Staff <|-down- Chef
Staff <|-down- Cashier
RestaurantGame "1" *-down- "0..6" Customer : -customers
RestaurantGame "1" *-down- "2" Table : -tables
Customer "0..1" -right- "0..1" Table : -table / -occupant
Customer <|-down- RegularCustomer
Customer "1" *-down- "0..1" Order : -order
Order "0..*" -right-> "1" MenuItemInterface : -item
MenuItemInterface <|.. MenuItem
!if $STAGE < 3
RestaurantGame -right-> "3" MenuItemInterface : -menu {ordered}
!else
RestaurantGame -right-> "6" MenuItemInterface : -menu {ordered}
!endif

!if $STAGE >= 2
!if $STAGE == 2
class VIPCustomer <<new>> {
!else
class VIPCustomer {
!endif
  # satisfactionLoss() : int
  # chooseMenuItem(menu: List<MenuItemInterface>) : MenuItemInterface
  + billAfterDiscount(baseCents: int) : int
}
!if $STAGE == 2
class CriticCustomer <<new>> {
!else
class CriticCustomer {
!endif
  # satisfactionLoss() : int
  # chooseMenuItem(menu: List<MenuItemInterface>) : MenuItemInterface
}
Customer <|-down- VIPCustomer
Customer <|-down- CriticCustomer
note bottom of VIPCustomer
  Loss: 5 per waiting turn.
  Bill: 90% of base price.
end note
note bottom of CriticCustomer
  Loss: 12; full price.
  Proposed preference: greatest preparation
  workload; ties use menu order.
end note
!endif

!if $STAGE == 3
interface Seating <<interface>> #EAF4EE {
  + seat(customer: Customer, table: Table) : void
}
class Host <<new>> {
  + seat(customer: Customer, table: Table) : void
}
Staff <|-down- Host
Seating <|.. Waiter
Seating <|.. Host
RestaurantGame "1" *-- "1" Host : -host
RestaurantGame ..> Seating : seating helper parameter
class ComboMeal <<new>> {
  + ComboMeal(first: MenuItemInterface, second: MenuItemInterface)
  + displayName() : String
  + priceCents() : int
  + preparationUnits() : int
}
MenuItemInterface <|.. ComboMeal
ComboMeal --> "1" MenuItemInterface : -first
ComboMeal --> "1" MenuItemInterface : -second
note bottom of ComboMeal
  Components are existing single dishes,
  shared by reference (not owned copies).
  Units = sum; price = round(sumCents * 90 / 100).
end note
note right of RestaurantGame
  Start turn; optional activateHappyHour();
  beginService() applies recovery before staff choices.
  Happy Hour: activate once at turn start;
  active on that turn and the next.
  Delegate +15 recovery (cap 100) to customers.
  calculateBill(): customer discount, then 20% off.
  Lock the resulting cents in the new Order.
  Existing orders keep their agreed prices.
end note
!endif

legend bottom left
  |= Symbol / appearance |= Meaning |
  | + / - / # / ~ | public / private / protected / package |
  | Italic class or operation | abstract |
  | Solid hollow triangle | inheritance |
  | Dashed hollow triangle | interface realisation |
  | Filled diamond at owner | composition |
  | Arrowed plain line | navigable association |
!if $STAGE > 1
  | Pale green | new in this stage |
!endif
!if $STAGE == 3
  | Pale yellow | changed from the preceding stage |
!endif
  Reference fields are represented by association ends, not duplicated in compartments.
  The waiting list is an ordered subset of customers; it is not a second composition owner.
endlegend
footer PROPOSED DESIGN - not an assertion of implemented code | SC2002 Ch. 6 notation; Ch. 9 responsibility boundaries.
