@startuml stage1-sequence-01-order
!include style.puml
title sd S1_ArrivalSeatingAndOrder\nCustomer 3 - turns 7 and 8
skinparam maxMessageSize 220
actor Manager as M
participant "console : RestaurantRush\n<<boundary>>" as UI
participant "game : RestaurantGame\n<<control>>" as G
participant "waiter : Waiter" as W
participant "table1 : Table\n<<entity>>" as T
participant "c3 : RegularCustomer\n<<entity>>" as C
participant "o3 : Order\n<<entity>>" as O

== Turn 7 - arrival and seating ==
UI -> G : startTurn()
activate G
G -> G : requirePhase(BETWEEN_TURNS)\nturn++
ref over G,W : Reset owned staff with beginTurn()
create C
G -->> C : <<create>> RegularCustomer(3)
note right of C : WAITING; satisfaction = 100
G -> G : customers.add(c3)\nwaiting.add(c3)\nphase = WAITER
G --> UI : return
deactivate G
UI -> G : eligibleFor(SEAT)
activate G
G --> UI : immutable CustomerView list
deactivate G
M -> UI : choose queue position 1, table 1
UI -> G : seat(3, 1)
activate G
G -> G : requirePhase(WAITER)\nfindCustomer(3); findTable(1)
G -> W : seat(c3, table1)
activate W
W -> W : requireAvailable()
W -> T : seat(c3)
activate T
T -> C : canBeSeated()
C --> T : true
T -> C : seatAt(table1)
activate C
note right of C : state = SEATED; table = table1
C --> T : return
deactivate C
T -> T : occupant = c3
T --> W : return
deactivate T
W -> W : recordSuccessfulTask()
W --> G : return
deactivate W
G -> G : waiting.remove(c3)\nphase = CHEF
G --> UI : return
deactivate G
M -> UI : Chef waits
UI -> G : waitChef()
UI -> G : finishTurn()
activate G
ref over G,C : Eating/payment checks; no payment for c3
G -> C : waitAtTurnEnd()
activate C
C -> C : satisfactionLoss() = 8
note right of C : satisfaction = 92
C --> G : return
deactivate C
G --> UI : return
deactivate G

== Turn 8 - customer chooses food ==
UI -> G : startTurn()
M -> UI : take customer 3's order
UI -> G : order(3)
activate G
G -> G : requirePhase(WAITER)
G -> W : takeOrder(c3)
activate W
W -> W : requireAvailable()
W -> C : placeOrder()
activate C
C -> C : canOrder() = true\nchooseMenuItem() = PASTA
create O
C -->> O : <<create>> Order(PASTA)
note right of O : PREPARING; 0/2 units\nbillCents = 1800
C --> W : return
deactivate C
W -> W : recordSuccessfulTask()
W --> G : return
deactivate W
G -> G : phase = CHEF
G --> UI : return
deactivate G
UI --> M : display chosen dish: Pasta
ref over UI,O : Continue with S2 Preparation and service
footer Ch. 6: boundary/control/entity | Ch. 7: object creation, activation bars, synchronous calls and replies.
@enduml
